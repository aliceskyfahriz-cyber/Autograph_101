<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Mission Control — AI Agent Ops</title>
<style>
  :root{
    --bg:#0b0d10; --panel:#12151a; --panel2:#171b21; --border:#232830;
    --text:#e6e9ee; --muted:#8b94a3; --muted2:#5d6675;
    --green:#4cc38a; --yellow:#e8b93e; --red:#e5534b; --blue:#5b8def; --gray:#8b94a3;
    --radius:16px; --shadow:0 6px 24px rgba(0,0,0,.35);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{background:var(--bg); color:var(--text); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif; font-size:14px; line-height:1.5; overflow-x:hidden;}
  a{color:var(--blue); text-decoration:none;} a:hover{text-decoration:underline;}
  button{font-family:inherit; cursor:pointer;}
  /* ---------- Layout ---------- */
  #sidebar{position:fixed; top:0; left:0; bottom:0; width:236px; background:var(--panel); border-right:1px solid var(--border); padding:18px 14px; display:flex; flex-direction:column; gap:6px; z-index:60; transition:transform .25s ease;}
  .brand{padding:2px 8px 16px;}
  .brand .b1{font-weight:700; letter-spacing:.08em; font-size:15px;}
  .brand .b2{display:block; color:var(--muted); font-size:12px; letter-spacing:.02em; margin-top:2px;}
  .navbtn{display:flex; align-items:center; gap:10px; width:100%; text-align:left; background:transparent; border:1px solid transparent; color:var(--text); padding:9px 10px; border-radius:10px; font-size:14px;}
  .navbtn:hover{background:var(--panel2);}
  .navbtn.active{background:var(--panel2); border-color:var(--border);}
  .navbtn .ico{width:20px; text-align:center; flex:none;}
  .navbtn .badge{margin-left:auto; background:var(--red); color:#fff; font-size:11px; font-weight:700; border-radius:999px; padding:0 7px; line-height:18px; min-width:18px; text-align:center;}
  .side-foot{margin-top:auto; padding:10px 8px 2px; border-top:1px solid var(--border); color:var(--muted); font-size:12px; display:flex; flex-direction:column; gap:6px; word-break:break-all;}
  main{margin-left:236px; min-height:100dvh; display:flex; flex-direction:column;}
  #topbar{position:sticky; top:0; z-index:50; display:flex; align-items:center; gap:12px; padding:12px 20px; background:rgba(11,13,16,.92); backdrop-filter:blur(8px); border-bottom:1px solid var(--border);}
  #topbar h1{font-size:16px; font-weight:650; margin-right:auto;}
  #hamburger{display:none; background:transparent; border:1px solid var(--border); color:var(--text); border-radius:10px; padding:6px 10px; font-size:16px;}
  .pill{display:inline-flex; align-items:center; gap:6px; border:1px solid var(--border); background:var(--panel2); border-radius:999px; padding:2px 10px; font-size:12px; color:var(--muted); white-space:nowrap;}
  .pill .dot{width:8px; height:8px; border-radius:50%; background:var(--gray); flex:none;}
  .pill.on .dot{background:var(--green);} .pill.off .dot{background:var(--red);}
  .pill.st-working{color:var(--green); border-color:rgba(76,195,138,.4);}
  .pill.st-idle{color:var(--muted);}
  .pill.st-paused{color:var(--yellow); border-color:rgba(232,185,62,.4);}
  .pill.st-done{color:var(--green);} .pill.st-failed{color:var(--red);} .pill.st-started,.pill.st-progress{color:var(--blue);}
  .pill.st-queued{color:var(--yellow);}
  .ghost{background:transparent; border:1px solid var(--border); color:var(--text); border-radius:10px; padding:7px 14px; font-size:13px;}
  .ghost:hover{background:var(--panel2);}
  .ghost.warn{border-color:rgba(232,185,62,.55); color:var(--yellow);}
  .ghost.small{padding:4px 10px; font-size:12px; border-radius:8px;}
  /* ---------- Views ---------- */
  .view{display:none; padding:20px; animation:fade .2s ease;}
  .view.active{display:block;}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  .grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:16px;}
  .card{background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); box-shadow:var(--shadow); padding:18px;}
  .cap{font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); font-weight:600;}
  .big{font-size:26px; font-weight:700; margin:6px 0 2px;}
  .sub{color:var(--muted); font-size:12.5px;}
  .bar{height:8px; background:var(--panel2); border:1px solid var(--border); border-radius:999px; overflow:hidden; margin-top:10px;}
  .bar > div{height:100%; background:var(--green); border-radius:999px; transition:width .5s ease;}
  .bar > div.mid{background:var(--yellow);} .bar > div.hot{background:var(--red);}
  .rowline{display:flex; align-items:flex-start; gap:12px; padding:12px 14px; background:var(--panel); border:1px solid var(--border); border-radius:12px; margin-bottom:10px;}
  .rowline .grow{flex:1; min-width:0;}
  .empty{color:var(--muted); border:1px dashed var(--border); border-radius:12px; padding:22px; text-align:center;}
  h3.sect{font-size:13px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin:4px 0 14px;}
  details.syst{margin-top:22px;} details.syst summary{cursor:pointer; color:var(--muted); font-size:13px; letter-spacing:.08em; text-transform:uppercase; margin-bottom:14px;}
  .chips{display:flex; flex-wrap:wrap; gap:6px; margin-top:8px;}
  .chip{font-size:12px; background:var(--panel2); border:1px solid var(--border); border-radius:999px; padding:2px 9px; color:var(--muted);}
  .logbox{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12.5px;}
  .logrow{display:flex; gap:10px; padding:8px 10px; border-bottom:1px solid var(--border); align-items:baseline;}
  .logrow time{color:var(--muted2); flex:none;}
  .logrow .src{flex:none; width:74px;}
  .logrow .txt{word-break:break-word;}
  input[type=text],select{background:var(--panel2); border:1px solid var(--border); color:var(--text); border-radius:10px; padding:9px 12px; font-size:14px; font-family:inherit;}
  input[type=text]{flex:1; min-width:160px;}
  form.qform{display:flex; gap:10px; flex-wrap:wrap; margin:16px 0 20px;}
  .quickrow{display:flex; gap:10px; flex-wrap:wrap;}
  pre.raw{background:var(--panel2); border:1px solid var(--border); border-radius:10px; padding:12px; font-size:12.5px; white-space:pre-wrap; margin-top:12px; color:var(--muted);}
  /* ---------- Virtual Office ---------- */
  #view-office{padding:0;}
  #officeWrap{position:relative; height:calc(100dvh - 57px); background:#0e1420; overflow:hidden;}
  #sceneContainer{position:absolute; inset:0;}
  #sceneContainer canvas{display:block;}
  #officeHud{position:absolute; left:14px; bottom:14px; display:flex; flex-direction:column; gap:8px; pointer-events:none; z-index:5;}
  .hud-card{background:rgba(13,16,21,.82); border:1px solid var(--border); border-radius:12px; padding:10px 14px; backdrop-filter:blur(6px); font-size:13px;}
  .hud-hint{color:rgba(230,233,238,.65); font-size:12px; padding-left:4px; text-shadow:0 1px 4px rgba(0,0,0,.6);}
  #mobileMenuBtn{display:none; position:absolute; top:12px; left:12px; z-index:6; background:rgba(13,16,21,.85); border:1px solid var(--border); color:var(--text); border-radius:10px; padding:8px 12px; font-size:15px;}
  #sceneFallback{position:absolute; inset:0; display:flex; align-items:center; justify-content:center; text-align:center; padding:30px; color:var(--muted); z-index:4;}
  #sceneFallback[hidden]{display:none;}
  #toast{position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(20px); background:var(--panel2); border:1px solid var(--border); color:var(--text); padding:10px 18px; border-radius:12px; box-shadow:var(--shadow); opacity:0; pointer-events:none; transition:all .25s ease; z-index:200; max-width:90vw; text-align:center;}
  #toast.show{opacity:1; transform:translateX(-50%) translateY(0);}
  /* ---------- Mobile ---------- */
  @media (max-width:860px){
    #sidebar{transform:translateX(-100%); width:250px;}
    #sidebar.open{transform:translateX(0); box-shadow:var(--shadow);}
    main{margin-left:0;}
    #hamburger{display:block;}
    #topbar{padding:10px 12px;}
    #clockWib{display:none;}
    .view{padding:14px;}
    body.office-active{overflow:hidden;}
    body.office-active #topbar{display:none;}
    body.office-active #view-office{position:fixed; inset:0; z-index:55;}
    body.office-active #officeWrap{height:100dvh; width:100vw;}
    #mobileMenuBtn{display:block;}
  }
</style>
</head>
<body>
<aside id="sidebar">
  <div class="brand"><span class="b1">MISSION CONTROL</span><span class="b2">Pusat kendali tim AI agent</span></div>
  <nav id="mainNav">
    <button class="navbtn active" data-view="office"><span class="ico">🛰️</span>Virtual Office</button>
    <button class="navbtn" data-view="overview"><span class="ico">🤖</span>Agent Overview</button>
    <button class="navbtn" data-view="queue"><span class="ico">📥</span>Task Queue<span class="badge" id="navQueueBadge" hidden>0</span></button>
    <button class="navbtn" data-view="metrics"><span class="ico">📊</span>System Metrics</button>
    <button class="navbtn" data-view="vps"><span class="ico">🖥️</span>VPS Status</button>
    <button class="navbtn" data-view="schedules"><span class="ico">🗓️</span>Tugas Terjadwal</button>
    <button class="navbtn" data-view="tokens"><span class="ico">🪙</span>Token Status</button>
    <button class="navbtn" data-view="fleet"><span class="ico">🚀</span>Agent Fleet</button>
    <button class="navbtn" data-view="log"><span class="ico">📜</span>Real-Time Log</button>
  </nav>
  <div class="side-foot">
    <span id="sideConn">● menghubungkan…</span>
    <span id="sidePublic"></span>
  </div>
</aside>

<main>
  <header id="topbar">
    <button id="hamburger" aria-label="Menu">☰</button>
    <h1 id="viewTitle">Virtual Office</h1>
    <span class="pill" id="clockWib">--:-- WIB</span>
    <span class="pill" id="connPill"><span class="dot"></span>menghubungkan…</span>
    <a id="publicLink" href="#" target="_blank" rel="noopener" hidden>URL Publik ↗</a>
    <button id="dispatchBtn" class="ghost">⏸ Pause Dispatch</button>
  </header>

  <section id="view-office" class="view active">
    <div id="officeWrap">
      <div id="sceneContainer"></div>
      <div id="sceneFallback" hidden><div>WebGL tidak tersedia di perangkat ini,<br>jadi ruangan 3D tidak bisa ditampilkan.<br><br>Data agent tetap bisa dilihat di menu <b>Agent Overview</b>.</div></div>
      <button id="mobileMenuBtn">☰ Menu</button>
      <div id="officeHud">
        <div class="hud-card" id="hudCounts">Memuat status agent…</div>
        <div class="hud-hint">Drag: putar kamera • Scroll / cubit: zoom • Klik robot: pause / resume agent</div>
      </div>
    </div>
  </section>

  <section id="view-overview" class="view"><div class="grid" id="agentCards"></div></section>

  <section id="view-queue" class="view">
    <h3 class="sect">Quick Task — tambah ke antrean</h3>
    <div class="quickrow">
      <button class="ghost" data-quick="research-agent-01" data-label="Research">🔎 Research</button>
      <button class="ghost" data-quick="coding-agent-02" data-label="Coding">💻 Coding</button>
      <button class="ghost" data-quick="vision-agent-03" data-label="Vision">👁️ Vision</button>
      <button class="ghost" data-quick="aris" data-label="Design">🎨 Design</button>
    </div>
    <form class="qform" id="queueForm">
      <input type="text" id="queuePrompt" placeholder="Tulis tugas cepat…" maxlength="500" required>
      <select id="queueAgent"></select>
      <button type="submit" class="ghost">+ Tambah Antrean</button>
    </form>
    <h3 class="sect">Antrean &amp; Riwayat</h3>
    <div id="queueList"></div>
  </section>

  <section id="view-metrics" class="view">
    <div class="grid" id="metricCards"></div>
    <p class="sub" style="margin-top:14px">Sumber: <code>/proc</code> di server ini, diperbarui tiap 3 detik. Memory container = jumlah RSS semua proses yang terlihat di <code>/proc</code>.</p>
  </section>

  <section id="view-vps" class="view"><div class="grid" id="vpsCards"></div></section>

  <section id="view-schedules" class="view">
    <h3 class="sect">Jadwal Saya</h3>
    <div id="schedMine"></div>
    <details class="syst">
      <summary>Jadwal Sistem</summary>
      <div id="schedSystem"></div>
    </details>
  </section>

  <section id="view-tokens" class="view"><div id="tokenCard" style="max-width:640px"></div></section>

  <section id="view-fleet" class="view"><div class="grid" id="fleetCards"></div></section>

  <section id="view-log" class="view"><div class="card logbox" id="logList" style="padding:6px 10px"></div></section>
</main>

<div id="toast"></div>

<script src="/vendor/three.min.js"></script>
<script>
'use strict';
/* ================= Helpers ================= */
const $ = (s) => document.querySelector(s);
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function fmtBytes(n){ if(n==null||isNaN(n)) return '—'; const u=['B','KB','MB','GB','TB']; let i=0,v=n; while(v>=1024&&i<u.length-1){v/=1024;i++;} return (Math.round(v*10)/10)+' '+u[i]; }
function fmtDT(iso){ if(!iso) return '—'; const d=new Date(iso); if(isNaN(d)) return esc(iso); return new Intl.DateTimeFormat('id-ID',{timeZone:'Asia/Jakarta',day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:false}).format(d).replace(/\./g,':')+' WIB'; }
function fmtTime(iso){ if(!iso) return ''; const d=new Date(iso); if(isNaN(d)) return ''; return new Intl.DateTimeFormat('id-ID',{timeZone:'Asia/Jakarta',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(d).replace(/\./g,':'); }
function fmtDur(sec){ if(sec==null) return '—'; sec=Math.floor(sec); const d=Math.floor(sec/86400),h=Math.floor(sec%86400/3600),m=Math.floor(sec%3600/60); if(d) return d+' hari '+h+' jam'; if(h) return h+' jam '+m+' menit'; if(m) return m+' menit '+(sec%60)+' dtk'; return sec+' detik'; }
function pctBar(pct){ const cls = pct>=90?'hot':(pct>=70?'mid':''); return '<div class="bar"><div class="'+cls+'" style="width:'+Math.min(100,Math.max(0,pct||0))+'%"></div></div>'; }
let toastTimer=null;
function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),3200); }
async function apiPost(path, body){ const r=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); const j=await r.json().catch(()=>({})); if(!r.ok) throw new Error(j.error||('HTTP '+r.status)); return j; }

/* ================= Navigasi ================= */
const TITLES={office:'Virtual Office',overview:'Agent Overview',queue:'Task Queue',metrics:'System Metrics',vps:'VPS Status',schedules:'Tugas Terjadwal',tokens:'Token Status',fleet:'Agent Fleet',log:'Real-Time Log'};
function setView(name){
  document.querySelectorAll('.navbtn').forEach(b=>b.classList.toggle('active',b.dataset.view===name));
  document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.id==='view-'+name));
  $('#viewTitle').textContent=TITLES[name]||name;
  document.body.classList.toggle('office-active', name==='office');
  $('#sidebar').classList.remove('open');
  if(name==='office'){ initScene(); resizeScene(); }
  window.scrollTo(0,0);
}
document.querySelectorAll('.navbtn').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.view)));
$('#hamburger').addEventListener('click',()=>$('#sidebar').classList.toggle('open'));
$('#mobileMenuBtn').addEventListener('click',()=>$('#sidebar').classList.toggle('open'));

/* ================= State & Polling ================= */
let S=null;
let prevTaskLatest=new Map();
let firstLoad=true;
async function poll(){
  try{
    const r=await fetch('/api/state',{cache:'no-store'});
    if(!r.ok) throw new Error('HTTP '+r.status);
    S=await r.json();
    $('#connPill').className='pill on'; $('#connPill').innerHTML='<span class="dot"></span>LIVE • '+fmtTime(S.now);
    $('#sideConn').textContent='● Terhubung • server '+ (S.system.node||'');
    renderAll();
    detectCheers();
  }catch(e){
    $('#connPill').className='pill off'; $('#connPill').innerHTML='<span class="dot"></span>OFFLINE';
    $('#sideConn').textContent='● Tidak terhubung ke server';
  }
}
function detectCheers(){
  const latest=new Map();
  for(const ev of S.tasks){ if(ev.task_id && !latest.has(ev.task_id)) latest.set(ev.task_id, ev); }
  if(!firstLoad){
    for(const [tid,ev] of latest){
      const prev=prevTaskLatest.get(tid);
      if(prev && (prev.status==='started'||prev.status==='progress') && ev.status==='done'){
        cheerAgent(ev.agent);
        toast('🎉 Task selesai: '+(ev.title||tid));
      }
      if(prev && (prev.status==='started'||prev.status==='progress') && ev.status==='failed'){
        toast('❌ Task gagal: '+(ev.title||tid));
      }
    }
  }
  prevTaskLatest=latest; firstLoad=false;
}
setInterval(poll,3000);
setInterval(()=>{ $('#clockWib').textContent=new Intl.DateTimeFormat('id-ID',{timeZone:'Asia/Jakarta',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date()).replace(/\./g,':')+' WIB'; },1000);

function agentById(id){ return S ? S.agents.find(a=>a.id===id) : null; }
function statusPill(st){ return '<span class="pill st-'+esc(st)+'">'+esc(st)+'</span>'; }

function renderAll(){
  if(!S) return;
  // badge antrean
  const qc=S.queue_queued_count||0;
  const badge=$('#navQueueBadge'); badge.hidden=qc===0; badge.textContent=qc;
  // URL publik
  const url=S.vps.tunnel.url;
  const pl=$('#publicLink');
  if(url){ pl.hidden=false; pl.href=url; $('#sidePublic').innerHTML='Publik: <a href="'+esc(url)+'" target="_blank" rel="noopener">'+esc(url)+'</a>'; }
  else { pl.hidden=true; $('#sidePublic').textContent='Publik: belum ada tunnel'; }
  // tombol dispatch
  const db=$('#dispatchBtn');
  db.textContent=S.dispatch_paused?'▶ Resume Dispatch':'⏸ Pause Dispatch';
  db.classList.toggle('warn',!!S.dispatch_paused);
  // HUD office
  const working=S.agents.filter(a=>a.status==='working').length;
  const idle=S.agents.filter(a=>a.status==='idle').length;
  const paused=S.agents.filter(a=>a.status==='paused').length;
  $('#hudCounts').innerHTML='🛰️ <b>'+working+'</b> bekerja • <b>'+idle+'</b> idle • <b>'+paused+'</b> pause'+(S.dispatch_paused?' • <span style="color:var(--yellow)">DISPATCH PAUSED</span>':'');
  renderOverview(); renderQueue(); renderMetrics(); renderVPS(); renderSchedules(); renderTokens(); renderFleet(); renderLog();
  updateSceneLayout();
  pushChartData(S.system.load_pct);
}

/* ================= Views ================= */
function renderOverview(){
  $('#agentCards').innerHTML=S.agents.map(a=>
    '<div class="card"><div style="display:flex;align-items:center;gap:10px"><span style="width:12px;height:12px;border-radius:50%;background:'+esc(a.color)+';flex:none"></span><b style="font-size:16px">'+esc(a.name)+'</b><span style="margin-left:auto">'+statusPill(a.status)+'</span></div>'+
    '<div class="sub" style="margin-top:4px">'+esc(a.role)+'</div>'+
    (a.active_task
      ? '<div style="margin-top:12px"><div class="cap">Task aktif</div><div style="margin-top:4px">'+esc(a.active_task.title||a.active_task.task_id)+'</div><div class="sub">'+esc(a.active_task.task_id)+' • sejak '+fmtDT(a.active_task.ts)+'</div>'+(a.active_task.detail?'<div class="sub">'+esc(a.active_task.detail)+'</div>':'')+'</div>'
      : '<div class="sub" style="margin-top:12px">Tidak ada task aktif.</div>')+
    '<div style="margin-top:14px"><button class="ghost small" data-toggle-pause="'+esc(a.id)+'">'+(a.paused_individual?'▶ Resume agent':'⏸ Pause agent')+'</button></div></div>'
  ).join('');
  document.querySelectorAll('[data-toggle-pause]').forEach(b=>b.addEventListener('click',()=>toggleAgentPause(b.dataset.togglePause)));
}
async function toggleAgentPause(id){
  const a=agentById(id); if(!a) return;
  try{ await apiPost('/api/agent-pause',{agent:id, paused:!a.paused_individual}); toast((!a.paused_individual?'⏸ ':'▶ ')+a.name+(!a.paused_individual?' di-pause':' dilanjutkan')); poll(); }
  catch(e){ toast('Gagal: '+e.message); }
}
function renderQueue(){
  const sel=$('#queueAgent');
  if(!sel.options.length){ sel.innerHTML=S.roster.map(r=>'<option value="'+esc(r.id)+'">'+esc(r.name)+' — '+esc(r.role)+'</option>').join(''); }
  if(!S.queue.length){ $('#queueList').innerHTML='<div class="empty">Antrean kosong. Tambahkan quick task di atas.</div>'; return; }
  $('#queueList').innerHTML=S.queue.map(q=>{
    const a=agentById(q.agent);
    return '<div class="rowline"><div class="grow"><div>'+esc(q.prompt)+'</div><div class="sub">'+esc(a?a.name:q.agent)+' • '+fmtDT(q.ts)+'</div></div>'+statusPill(q.status)+'</div>';
  }).join('');
}
document.querySelectorAll('[data-quick]').forEach(b=>b.addEventListener('click',async()=>{
  try{ await apiPost('/api/queue',{prompt:'Quick task: '+b.dataset.label, agent:b.dataset.quick}); toast('📥 Quick task '+b.dataset.label+' masuk antrean'); poll(); }
  catch(e){ toast('Gagal: '+e.message); }
}));
$('#queueForm').addEventListener('submit',async(e)=>{
  e.preventDefault();
  const prompt=$('#queuePrompt').value.trim(); if(!prompt) return;
  try{ await apiPost('/api/queue',{prompt, agent:$('#queueAgent').value}); $('#queuePrompt').value=''; toast('📥 Task masuk antrean'); poll(); }
  catch(err){ toast('Gagal: '+err.message); }
});
function renderMetrics(){
  const sy=S.system, mh=sy.mem_host||{};
  const hostUsed=(mh.total&&mh.available!=null)?(mh.total-mh.available):null;
  const hostPct=(mh.total&&hostUsed!=null)?Math.round(hostUsed/mh.total*1000)/10:null;
  $('#metricCards').innerHTML=
    '<div class="card"><div class="cap">CPU Load</div><div class="big">'+sy.load_pct+'%</div><div class="sub">loadavg '+sy.loadavg.join(' • ')+' pada '+sy.cores+' core</div>'+pctBar(sy.load_pct)+'<div class="sub" style="margin-top:8px">'+esc(sy.cpu_model||'')+'</div></div>'+
    '<div class="card"><div class="cap">Memory Host (seluruh mesin)</div><div class="big">'+(hostPct!=null?hostPct+'%':'—')+'</div><div class="sub">terpakai '+fmtBytes(hostUsed)+' dari '+fmtBytes(mh.total)+'</div>'+(hostPct!=null?pctBar(hostPct):'')+'</div>'+
    '<div class="card"><div class="cap">Memory (Container)</div><div class="big">'+fmtBytes(sy.mem_container_bytes)+'</div><div class="sub">jumlah RSS '+sy.proc_count+' proses di /proc</div></div>'+
    '<div class="card"><div class="cap">Uptime Server</div><div class="big" style="font-size:22px">'+fmtDur(sy.uptime_sec)+'</div><div class="sub">sejak boot mesin</div></div>'+
    '<div class="card"><div class="cap">Uptime Aplikasi Dashboard</div><div class="big" style="font-size:22px">'+fmtDur(sy.server_uptime_sec)+'</div><div class="sub">proses Node '+esc(sy.node)+'</div></div>'+
    '<div class="card"><div class="cap">Proses Terlihat</div><div class="big">'+sy.proc_count+'</div><div class="sub">entri numerik di /proc saat dibaca</div></div>';
}
function renderVPS(){
  const v=S.vps;
  const diskPct=v.disk.pct;
  const tun=v.tunnel;
  const tunBadge=tun.online===true?'<span class="pill st-done">ONLINE</span>':(tun.online===false?'<span class="pill st-failed">OFFLINE</span>':'<span class="pill">MENUNGGU CEK</span>');
  const wd=v.watchdog||{};
  $('#vpsCards').innerHTML=
    '<div class="card"><div class="cap">Disk</div><div class="big">'+(diskPct!=null?diskPct+'%':'—')+'</div><div class="sub">terpakai '+fmtBytes(v.disk.used)+' dari '+fmtBytes(v.disk.total)+' (mount '+esc(v.disk.mount)+')</div>'+(diskPct!=null?pctBar(diskPct):'')+(diskPct>=90?'<div class="sub" style="color:var(--red);margin-top:8px">⚠ Disk hampir penuh (≥90%)</div>':'')+'</div>'+
    '<div class="card"><div class="cap">CPU</div><div class="big" style="font-size:20px">'+esc(v.cpu.model||'—')+'</div><div class="sub">'+v.cpu.cores+' core • load '+v.cpu.load_pct+'% ('+v.cpu.loadavg.join(', ')+')</div>'+pctBar(v.cpu.load_pct)+'</div>'+
    '<div class="card"><div class="cap">'+esc(v.memory_container.label)+'</div><div class="big">'+fmtBytes(v.memory_container.bytes)+'</div><div class="sub">'+esc(v.memory_container.subtext)+'</div><div class="sub" style="margin-top:6px">dari '+v.memory_container.proc_count+' proses yang terlihat</div></div>'+
    '<div class="card"><div class="cap">Uptime Server</div><div class="big" style="font-size:22px">'+fmtDur(v.uptime_sec)+'</div><div class="sub">host: '+esc(v.hostname)+'</div></div>'+
    '<div class="card"><div class="cap">Tunnel</div><div style="margin:8px 0">'+tunBadge+'</div>'+(tun.url?'<div><a href="'+esc(tun.url)+'" target="_blank" rel="noopener">'+esc(tun.url)+'</a></div>':'<div class="sub">Belum ada URL publik (PUBLIC_URL.txt kosong)</div>')+'<div class="sub" style="margin-top:6px">proses bore: '+(tun.bore_alive?'berjalan':'tidak berjalan')+(tun.checked_at?' • cek terakhir '+fmtTime(tun.checked_at):'')+'</div></div>'+
    '<div class="card"><div class="cap">OS</div><div class="big" style="font-size:20px">'+esc(v.os)+'</div><div class="sub">kernel '+esc(v.kernel)+' • '+esc(v.hostname)+'</div></div>'+
    '<div class="card"><div class="cap">Watchdog Terakhir Jalan</div><div class="big" style="font-size:20px">'+(wd.last_run?fmtDT(wd.last_run):'Belum pernah jalan')+'</div><div class="sub">status: '+esc(wd.last_status||'—')+'</div>'+(wd.last_event?'<div class="sub" style="margin-top:6px">event terakhir: '+esc(wd.last_event.event||'')+' '+esc(wd.last_event.new_url||wd.last_event.url||'')+' '+esc(wd.last_event.reason||'')+'</div>':'')+'</div>';
}
function schedRow(x){
  return '<div class="rowline"><div class="grow"><div><b>'+esc(x.title)+'</b> '+(x.enabled?'<span class="pill st-done">ON</span>':'<span class="pill">OFF</span>')+'</div><div class="sub">'+esc(x.label)+(x.owner?' • owner '+esc(x.owner):'')+' • zona '+esc(x.timezone)+'</div></div><div style="text-align:right;flex:none"><div class="cap">Berikutnya</div><div class="sub" style="color:var(--text)">'+(x.next_iso?fmtDT(x.next_iso):'—')+'</div></div></div>';
}
function renderSchedules(){
  const mine=S.schedules.filter(x=>!x.is_system), syst=S.schedules.filter(x=>x.is_system);
  $('#schedMine').innerHTML=mine.length?mine.map(schedRow).join(''):'<div class="empty">Tidak ada jadwal pengguna ditemukan di folder cron.</div>';
  $('#schedSystem').innerHTML=syst.length?syst.map(schedRow).join(''):'<div class="empty">Tidak ada jadwal sistem yang terbaca dari file (folder system-cron.d tidak ditemukan di disk saat ini).</div>';
}
function renderTokens(){
  const t=S.token||{};
  if(!t.available){
    $('#tokenCard').innerHTML='<div class="card"><div class="cap">Token Status</div><div class="big" style="font-size:20px">Belum tersambung</div><div class="sub">Backend mencoba membaca pemakaian lewat perintah <code>subscription-status status</code> dan belum berhasil. Tidak ada angka yang ditampilkan agar tidak menampilkan data palsu.</div>'+(t.error?'<pre class="raw">'+esc(t.error)+'</pre>':'')+'</div>';
    return;
  }
  $('#tokenCard').innerHTML='<div class="card"><div class="cap">Pemakaian Token / Paket</div>'+
    '<div class="big">'+(t.usage_percent!=null?t.usage_percent+'%':'—')+'</div>'+
    '<div class="sub">terpakai dari '+(esc(t.usage_scope||'batas paket'))+'</div>'+(t.usage_percent!=null?pctBar(t.usage_percent):'')+
    '<div style="margin-top:16px;display:flex;flex-direction:column;gap:8px">'+
    '<div>Paket: <b>'+(t.has_subscription?'Berlangganan aktif':'Tidak ada langganan (paket gratis)')+'</b></div>'+
    (t.resets?'<div>Reset batas: <b>'+esc(t.resets)+'</b></div>':'')+
    (t.additional_percent!=null?'<div>Token tambahan: <b>'+t.additional_percent+'% terpakai</b>'+(t.additional_left?' ('+esc(t.additional_left)+')':'')+'</div>':'')+
    (t.checked_at?'<div class="sub">Diperiksa: '+fmtDT(t.checked_at)+'</div>':'')+
    '</div>'+(t.raw?'<pre class="raw">'+esc(t.raw)+'</pre>':'')+'</div>';
}
function renderFleet(){
  $('#fleetCards').innerHTML=S.roster.map(r=>{
    const a=agentById(r.id);
    return '<div class="card"><div style="display:flex;align-items:center;gap:10px"><span style="width:12px;height:12px;border-radius:50%;background:'+esc(r.color)+';flex:none"></span><b style="font-size:16px">'+esc(r.name)+'</b><span style="margin-left:auto">'+(a?statusPill(a.status):'')+'</span></div>'+
    '<div class="sub" style="margin-top:4px">'+esc(r.role)+' • id <code>'+esc(r.id)+'</code></div>'+
    '<div class="sub" style="margin-top:8px">Ciri visual: '+esc(r.visual)+'</div>'+
    '<div class="chips">'+r.capabilities.map(c=>'<span class="chip">'+esc(c)+'</span>').join('')+'</div></div>';
  }).join('');
}
function renderLog(){
  if(!S.log.length){ $('#logList').innerHTML='<div class="empty">Belum ada log aktivitas.</div>'; return; }
  $('#logList').innerHTML=S.log.map(l=>'<div class="logrow"><time>'+esc(fmtTime(l.ts)||'')+'</time><span class="src pill">'+esc(l.source)+'</span><span class="txt">'+esc(l.text)+'</span></div>').join('');
}
$('#dispatchBtn').addEventListener('click',async()=>{
  if(!S) return;
  try{ await apiPost('/api/dispatch',{paused:!S.dispatch_paused}); toast(S.dispatch_paused?'▶ Dispatch dilanjutkan':'⏸ Dispatch di-pause'); poll(); }
  catch(e){ toast('Gagal: '+e.message); }
});

/* ================= Grafik untuk monitor 3D (data nyata) ================= */
const loadHistory=[];
function pushChartData(v){ if(typeof v==='number'){ loadHistory.push(v); if(loadHistory.length>48) loadHistory.shift(); drawChartCanvas(); } }

