let sceneReady=false, renderer3=null, scene3=null, camera3=null, robots={}, stationScreens=[];
let orbit={theta:0.55, phi:1.02, radius:11.5, tx:0, ty:1.1, tz:-1};
let codeCanvas, codeCtx, codeTex, chartCanvas, chartCtx, chartTex, lampMat, clockT0=Date.now();
const OWNER_LOGO_URI='data:image/jpeg;base64,