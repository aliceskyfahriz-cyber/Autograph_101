'; // poster ROG kiriman Fahriz (dinding kiri) // logo STAYFOCUS / Auto Graph milik Fahriz (poster dinding)

const STATION_X=[-3.9,-2.34,-0.78,0.78,2.34,3.9];
const BACK_X=[-3.9,-2.34,-0.78,0.78,2.34,3.9];

function makeLabelSprite(name){
  const c=document.createElement('canvas'); c.width=512; c.height=128;
  const tex=new THREE.CanvasTexture(c);
  const spr=new THREE.Sprite(new THREE.SpriteMaterial({map:tex, transparent:true, depthTest:false}));
  spr.scale.set(1.9,0.475,1);
  spr.userData={canvas:c, tex};
  drawLabel(spr, name, '#8b94a3');
  return spr;
}
function drawLabel(spr, name, color){
  const c=spr.userData.canvas, g=c.getContext('2d');
  g.clearRect(0,0,512,128);
  g.fillStyle='rgba(10,13,17,0.78)';
  g.beginPath();
  const r=34,x=86,y=22,w=340,h=84;
  g.moveTo(x+r,y); g.arcTo(x+w,y,x+w,y+h,r); g.arcTo(x+w,y+h,x,y+h,r); g.arcTo(x,y+h,x,y,r); g.arcTo(x,y,x+w,y,r); g.closePath(); g.fill();
  g.fillStyle=color; g.beginPath(); g.arc(128,64,15,0,Math.PI*2); g.fill();
  g.fillStyle='#e6e9ee'; g.font='700 42px system-ui, sans-serif'; g.textBaseline='middle';
  g.fillText(name, 162, 66);
  spr.userData.tex.needsUpdate=true;
}
function mat(color, opts){ return new THREE.MeshStandardMaterial(Object.assign({color, roughness:0.75, metalness:0.08}, opts||{})); }

function buildRobot(def){
  const g=new THREE.Group();
  const accent=new THREE.Color(def.color);
  const bodyM=mat(0x2a3140), lightM=mat(0xc9d2dd), darkM=mat(0x171c24);
  // kaki (pivot di pinggul, supaya bisa mengayun saat berjalan)
  const legs=new THREE.Group();
  const legPivots={};
  [-1,1].forEach(s=>{ const pivot=new THREE.Group(); pivot.position.set(0.16*s,0.52,0);
    const leg=new THREE.Mesh(new THREE.BoxGeometry(0.2,0.5,0.24), darkM); leg.position.y=-0.26; pivot.add(leg);
    const foot=new THREE.Mesh(new THREE.BoxGeometry(0.24,0.08,0.34), bodyM); foot.position.set(0,-0.48,0.04); pivot.add(foot);
    legs.add(pivot); legPivots[s<0?'L':'R']=pivot; });
  g.add(legs);
  const legL=legPivots.L, legR=legPivots.R;
  // badan
  const body=new THREE.Mesh(new THREE.BoxGeometry(0.66,0.72,0.42), bodyM); body.position.y=0.87; g.add(body);
  const chest=new THREE.Mesh(new THREE.BoxGeometry(0.4,0.3,0.03), new THREE.MeshStandardMaterial({color:accent, roughness:0.5, emissive:accent, emissiveIntensity:0.25}));
  chest.position.set(0,0.92,0.22); g.add(chest);
  // lengan (pivot di bahu)
  function arm(side){
    const pivot=new THREE.Group(); pivot.position.set(0.42*side,1.16,0);
    const a=new THREE.Mesh(new THREE.BoxGeometry(0.16,0.58,0.18), bodyM); a.position.y=-0.26; pivot.add(a);
    const hand=new THREE.Mesh(new THREE.SphereGeometry(0.09,12,10), lightM); hand.position.y=-0.56; pivot.add(hand);
    g.add(pivot); return pivot;
  }
  const armL=arm(-1), armR=arm(1);
  // kepala
  const headG=new THREE.Group(); headG.position.y=1.52; g.add(headG);
  const head=new THREE.Mesh(new THREE.BoxGeometry(0.56,0.54,0.5), lightM); headG.add(head);
  const visor=new THREE.Mesh(new THREE.BoxGeometry(0.48,0.24,0.03), darkM); visor.position.set(0,0.03,0.26); headG.add(visor);
  const eyeM=new THREE.MeshBasicMaterial({color:0x9fe8ff});
  const eyeGeo=new THREE.CircleGeometry(0.045,16);
  const eyeL=new THREE.Mesh(eyeGeo, eyeM); eyeL.position.set(-0.11,0.03,0.28); headG.add(eyeL);
  const eyeR=new THREE.Mesh(eyeGeo, eyeM); eyeR.position.set(0.11,0.03,0.28); headG.add(eyeR);
  let extra={};
  if(def.id==='muse' || def.id==='research-agent-01'){
    const ant=new THREE.Mesh(new THREE.CylinderGeometry(0.02,0.02,def.id==='research-agent-01'?0.5:0.34,8), darkM);
    ant.position.set(0.18,0.42,0); headG.add(ant);
    const tip=new THREE.Mesh(new THREE.SphereGeometry(0.05,10,8), new THREE.MeshBasicMaterial({color:accent})); tip.position.set(0.18,def.id==='research-agent-01'?0.68:0.6,0); headG.add(tip);
  }
  if(def.id==='aris'){
    const beret=new THREE.Mesh(new THREE.CylinderGeometry(0.36,0.38,0.09,20), mat(0x7b4bc4)); beret.position.set(0.05,0.32,0); beret.rotation.z=0.12; headG.add(beret);
    const stem=new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,0.08,8), mat(0x7b4bc4)); stem.position.set(0.05,0.4,0); headG.add(stem);
    const tablet=new THREE.Mesh(new THREE.BoxGeometry(0.5,0.36,0.03), darkM); tablet.position.set(-0.45,0.75,0.3); tablet.rotation.x=-0.5; g.add(tablet);
    const stylus=new THREE.Mesh(new THREE.CylinderGeometry(0.02,0.02,0.34,8), lightM); stylus.position.set(0.45,0.62,0.3); stylus.rotation.z=0.7; stylus.rotation.x=0.6; g.add(stylus);
  }
  if(def.id==='udin'){
    const band=new THREE.Mesh(new THREE.TorusGeometry(0.34,0.045,10,24,Math.PI), darkM); band.position.set(0,0.08,0); band.rotation.z=0; headG.add(band);
    [-1,1].forEach(s=>{ const cup=new THREE.Mesh(new THREE.CylinderGeometry(0.11,0.11,0.09,14), mat(0xe5534b)); cup.rotation.z=Math.PI/2; cup.position.set(0.31*s,0.02,0); headG.add(cup); });
    const recM=new THREE.MeshBasicMaterial({color:0xff3b30});
    const rec=new THREE.Mesh(new THREE.SphereGeometry(0.045,10,8), recM); rec.position.set(0.2,0.3,0.2); headG.add(rec);
    extra.recM=recM;
  }
  if(def.id==='vision-agent-03'){
    const cam=new THREE.Mesh(new THREE.CylinderGeometry(0.13,0.15,0.16,18), darkM); cam.rotation.x=Math.PI/2; cam.position.set(0,0.03,0.32); headG.add(cam);
    const lens=new THREE.Mesh(new THREE.CircleGeometry(0.085,18), new THREE.MeshBasicMaterial({color:0x66d9e8})); lens.position.set(0,0.03,0.41); headG.add(lens);
    eyeL.visible=false; eyeR.visible=false; extra.lens=lens;
  }
  if(def.id==='research-agent-01'){
    const ring=new THREE.Mesh(new THREE.TorusGeometry(0.14,0.025,10,24), mat(0xe8b93e)); ring.position.set(0.5,0.72,0.28); g.add(ring);
    const glass=new THREE.Mesh(new THREE.CircleGeometry(0.12,24), new THREE.MeshBasicMaterial({color:0xbfe8ff, transparent:true, opacity:0.35})); glass.position.set(0.5,0.72,0.28); g.add(glass);
    const handle=new THREE.Mesh(new THREE.CylinderGeometry(0.02,0.02,0.22,8), darkM); handle.position.set(0.56,0.55,0.28); handle.rotation.z=0.5; g.add(handle);
  }
  if(def.id==='coding-agent-02'){
    const kb=new THREE.Mesh(new THREE.BoxGeometry(0.72,0.05,0.26), darkM); kb.position.set(0,0.62,0.32); kb.rotation.x=0.25; g.add(kb);
    const kbTop=new THREE.Mesh(new THREE.BoxGeometry(0.66,0.02,0.2), mat(0x39424f)); kbTop.position.set(0,0.65,0.33); kbTop.rotation.x=0.25; g.add(kbTop);
  }
  const label=makeLabelSprite(def.name); label.position.y=2.12; g.add(label);
  g.traverse(o=>{ o.userData.robotId=def.id; });
  return { def, group:g, legs, legL, legR, armL, armR, headG, eyeL, eyeR, label, extra,
           status:'idle', seated:false, targetSeated:false,
           target:new THREE.Vector3(), hopStart:-1, blinkAt:2+Math.random()*3, blinkPhase:0, phase:Math.random()*10,
           walkTarget:null, waitUntil:0, walkPhase:Math.random()*10, faceY:0, moving:false, lastTick:0 };
}
function cheerAgent(id){ const r=robots[id]; if(r) r.hopStart=performance.now(); }

function drawCityTexture(){
  const c=document.createElement('canvas'); c.width=1024; c.height=512; const g=c.getContext('2d');
  const grad=g.createLinearGradient(0,0,0,512); grad.addColorStop(0,'#0a1122'); grad.addColorStop(1,'#1a2a47'); g.fillStyle=grad; g.fillRect(0,0,1024,512);
  g.fillStyle='#e8ecf4'; g.beginPath(); g.arc(880,86,34,0,Math.PI*2); g.fill();
  g.fillStyle='rgba(232,236,244,0.16)'; g.beginPath(); g.arc(880,86,52,0,Math.PI*2); g.fill();
  let seed=42; const rnd=()=>{ seed=(seed*16807)%2147483647; return seed/2147483647; };
  for(let i=0;i<130;i++){ g.fillStyle='rgba(255,255,255,'+(0.35+rnd()*0.6)+')'; g.fillRect(rnd()*1024, rnd()*180, 2, 2); }
  let x=-10;
  while(x<1024){ const w=50+rnd()*80, h=120+rnd()*230; g.fillStyle='#0d1524'; g.fillRect(x,512-h,w,h);
    for(let wy=512-h+14; wy<500; wy+=20) for(let wx=x+8; wx<x+w-10; wx+=16){ if(rnd()>0.55){ g.fillStyle=rnd()>0.3?'rgba(255,205,110,0.9)':'rgba(190,225,255,0.9)'; g.fillRect(wx,wy,8,11); } }
    x+=w+6; }
  return new THREE.CanvasTexture(c);
}
function initScene(){
  if(sceneReady) return;
  const container=$('#sceneContainer');
  if(!window.THREE){ $('#sceneFallback').hidden=false; return; }
  try{
    renderer3=new THREE.WebGLRenderer({antialias:true});
  }catch(e){ $('#sceneFallback').hidden=false; return; }
  renderer3.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  container.appendChild(renderer3.domElement);
  scene3=new THREE.Scene();
  scene3.background=new THREE.Color(0x0e1420);
  scene3.fog=new THREE.Fog(0x0e1420, 18, 34);
  camera3=new THREE.PerspectiveCamera(50, 1, 0.1, 100);

  scene3.add(new THREE.AmbientLight(0xbfd0e6, 0.5));
  const key=new THREE.DirectionalLight(0xffffff, 0.55); key.position.set(5,9,7); scene3.add(key);
  const warm=new THREE.PointLight(0xffd9a0, 0.9, 12); warm.position.set(-5.3,2.4,-1); scene3.add(warm);

  // lantai & dinding
  const floor=new THREE.Mesh(new THREE.PlaneGeometry(17,11), mat(0x161c26,{roughness:0.95}));
  floor.rotation.x=-Math.PI/2; floor.position.z=-0.5; scene3.add(floor);
  const rug=new THREE.Mesh(new THREE.PlaneGeometry(11,4.6), mat(0x10151d,{roughness:1}));
  rug.rotation.x=-Math.PI/2; rug.position.set(0,0.01,-1.1); scene3.add(rug);
  const backWall=new THREE.Mesh(new THREE.PlaneGeometry(17,6), mat(0x1b2431)); backWall.position.set(0,3,-5.5); scene3.add(backWall);
  const leftWall=new THREE.Mesh(new THREE.PlaneGeometry(11,6), mat(0x18202c)); leftWall.rotation.y=Math.PI/2; leftWall.position.set(-8.5,3,-0.5); scene3.add(leftWall);

  // jendela kota malam
  const winFrame=new THREE.Mesh(new THREE.BoxGeometry(5.6,3.1,0.12), mat(0x0c0f14));
  winFrame.position.set(2.4,3.1,-5.44); scene3.add(winFrame);
  const city=new THREE.Mesh(new THREE.PlaneGeometry(5.3,2.85), new THREE.MeshBasicMaterial({map:drawCityTexture()}));
  city.position.set(2.4,3.1,-5.37); scene3.add(city);

  // meja panjang + stasiun kerja
  const desk=new THREE.Mesh(new THREE.BoxGeometry(9.6,0.1,1.15), mat(0x232b38)); desk.position.set(0,0.92,-0.55); scene3.add(desk);
  [-4.5,4.5].forEach(x=>{ const leg=new THREE.Mesh(new THREE.BoxGeometry(0.12,0.9,0.9), mat(0x1a212c)); leg.position.set(x,0.45,-0.55); scene3.add(leg); });

  // canvas monitor kode (data log nyata) & chart (load CPU nyata)
  codeCanvas=document.createElement('canvas'); codeCanvas.width=512; codeCanvas.height=320; codeCtx=codeCanvas.getContext('2d');
  codeTex=new THREE.CanvasTexture(codeCanvas);
  chartCanvas=document.createElement('canvas'); chartCanvas.width=512; chartCanvas.height=320; chartCtx=chartCanvas.getContext('2d');
  chartTex=new THREE.CanvasTexture(chartCanvas);
  drawChartCanvas();

  STATION_X.forEach((x,i)=>{
    // kursi
    const chair=new THREE.Group();
    const seat=new THREE.Mesh(new THREE.BoxGeometry(0.58,0.08,0.52), mat(0x2c3646)); seat.position.y=0.52; chair.add(seat);
    const back=new THREE.Mesh(new THREE.BoxGeometry(0.58,0.72,0.08), mat(0x2c3646)); back.position.set(0,0.95,-0.27); chair.add(back);
    const pole=new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.05,0.5,10), mat(0x11161e)); pole.position.y=0.26; chair.add(pole);
    chair.position.set(x,0,-1.42); scene3.add(chair);
    // monitor
    const mon=new THREE.Group();
    const scr=new THREE.Mesh(new THREE.BoxGeometry(0.98,0.62,0.05), mat(0x0c0f14)); scr.position.y=0.33; mon.add(scr);
    let screenMat;
    if(i===2){ screenMat=new THREE.MeshBasicMaterial({map:codeTex}); }
    else if(i===3){ screenMat=new THREE.MeshBasicMaterial({map:chartTex}); }
    else { screenMat=new THREE.MeshBasicMaterial({color:0x11161d}); stationScreens[i]=screenMat; }
    const plane=new THREE.Mesh(new THREE.PlaneGeometry(0.9,0.54), screenMat); plane.position.set(0,0.33,0.03); mon.add(plane);
    const stand=new THREE.Mesh(new THREE.BoxGeometry(0.08,0.2,0.08), mat(0x11161e)); stand.position.y=0.02; mon.add(stand);
    mon.position.set(x,0.97,-0.82); scene3.add(mon);
  });

  // lampu status di atas meja
  const lampBase=new THREE.Mesh(new THREE.SphereGeometry(0.09,14,12), mat(0x11161e)); lampBase.position.set(0,1.02,-0.2); scene3.add(lampBase);
  lampMat=new THREE.MeshBasicMaterial({color:0x8b94a3});
  const lampBall=new THREE.Mesh(new THREE.SphereGeometry(0.055,14,12), lampMat); lampBall.position.set(0,1.16,-0.2); scene3.add(lampBall);

  // lampu berdiri + tanaman
  const pole2=new THREE.Mesh(new THREE.CylinderGeometry(0.035,0.035,2.1,10), mat(0x11161e)); pole2.position.set(-5.3,1.05,-1); scene3.add(pole2);
  const shade=new THREE.Mesh(new THREE.ConeGeometry(0.3,0.42,18,1,true), mat(0xd9b380,{side:THREE.DoubleSide})); shade.position.set(-5.3,2.25,-1); scene3.add(shade);
  const plant=new THREE.Group();
  const pot=new THREE.Mesh(new THREE.CylinderGeometry(0.26,0.2,0.42,14), mat(0x6e4a34)); pot.position.y=0.21; plant.add(pot);
  [[0,0.85,0,0.42],[0.25,0.7,0.1,0.3],[-0.24,0.72,-0.08,0.32]].forEach(p=>{ const s=new THREE.Mesh(new THREE.SphereGeometry(p[3],12,10), mat(0x3f7d4e)); s.position.set(p[0],p[1],p[2]); plant.add(s); });
  plant.position.set(5.4,0,-3.4); scene3.add(plant);

  // ===== Poster logo pemilik di dinding belakang (STAYFOCUS / Auto Graph) =====
  const logoImg=new Image();
  const logoTex=new THREE.Texture(logoImg);
  logoTex.minFilter=THREE.LinearFilter; logoTex.magFilter=THREE.LinearFilter; logoTex.generateMipmaps=false;
  logoImg.onload=()=>{ logoTex.needsUpdate=true; };
  logoImg.src=OWNER_LOGO_URI;
  const posterFrame=new THREE.Mesh(new THREE.BoxGeometry(2.9,2.9,0.09), mat(0x0c0f14));
  posterFrame.position.set(-5.6,3.15,-5.45); scene3.add(posterFrame);
  const poster=new THREE.Mesh(new THREE.PlaneGeometry(2.66,2.66), new THREE.MeshBasicMaterial({map:logoTex}));
  poster.position.set(-5.6,3.15,-5.39); scene3.add(poster);
  const plateC=document.createElement('canvas'); plateC.width=512; plateC.height=64;
  const pg=plateC.getContext('2d'); pg.fillStyle='#0c0f14'; pg.fillRect(0,0,512,64);
  pg.fillStyle='#e8ecf4'; pg.font='700 29px system-ui, sans-serif'; pg.textAlign='center'; pg.textBaseline='middle';
  pg.fillText('STAYFOCUS  ×  AUTO GRAPH', 256, 34);
  const plate=new THREE.Mesh(new THREE.PlaneGeometry(2.4,0.3), new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(plateC)}));
  plate.position.set(-5.6,1.52,-5.42); scene3.add(plate);

  // ===== Poster kedua kiriman Fahriz (ROG) di dinding kiri =====
  const rogImg=new Image();
  const rogTex=new THREE.Texture(rogImg);
  rogTex.minFilter=THREE.LinearFilter; rogTex.magFilter=THREE.LinearFilter; rogTex.generateMipmaps=false;
  rogImg.onload=()=>{ rogTex.needsUpdate=true; };
  rogImg.src=OWNER_ROG_URI;
  const rogFrame=new THREE.Mesh(new THREE.BoxGeometry(0.09,1.95,3.6), mat(0x0c0f14));
  rogFrame.position.set(-8.46,2.95,2.6); scene3.add(rogFrame);
  const rogPoster=new THREE.Mesh(new THREE.PlaneGeometry(3.36,1.71), new THREE.MeshBasicMaterial({map:rogTex}));
  rogPoster.rotation.y=Math.PI/2;
  rogPoster.position.set(-8.4,2.95,2.6); scene3.add(rogPoster);

  // ===== Dekor apartemen: jam dinding, sofa + meja kopi, rak buku =====
  const clockG=new THREE.Group();
  const rim=new THREE.Mesh(new THREE.CylinderGeometry(0.42,0.42,0.07,24), mat(0x0c0f14)); rim.rotation.x=Math.PI/2; clockG.add(rim);
  const face=new THREE.Mesh(new THREE.CircleGeometry(0.36,24), new THREE.MeshBasicMaterial({color:0xe8ecf4})); face.position.z=0.045; clockG.add(face);
  const hourH=new THREE.Mesh(new THREE.BoxGeometry(0.045,0.22,0.01), mat(0x11161d)); hourH.position.set(0.05,0.05,0.055); hourH.rotation.z=-0.8; clockG.add(hourH);
  const minH=new THREE.Mesh(new THREE.BoxGeometry(0.035,0.31,0.01), mat(0x11161d)); minH.position.set(-0.03,0.1,0.055); minH.rotation.z=0.35; clockG.add(minH);
  clockG.position.set(6.9,3.9,-5.44); scene3.add(clockG);

  const sofa=new THREE.Group(); const sofaM=mat(0x2e3a4a), cushM=mat(0x39485c);
  const sBase=new THREE.Mesh(new THREE.BoxGeometry(0.85,0.42,2.3), sofaM); sBase.position.y=0.3; sofa.add(sBase);
  const sBack=new THREE.Mesh(new THREE.BoxGeometry(0.24,0.85,2.3), sofaM); sBack.position.set(0.34,0.62,0); sofa.add(sBack);
  [-1,1].forEach(s=>{ const armS=new THREE.Mesh(new THREE.BoxGeometry(0.85,0.3,0.24), sofaM); armS.position.set(0,0.66,1.05*s); sofa.add(armS);
    const cush=new THREE.Mesh(new THREE.BoxGeometry(0.62,0.14,1.0), cushM); cush.position.set(-0.04,0.56,0.55*s); sofa.add(cush); });
  sofa.position.set(7.35,0,2.6); scene3.add(sofa);
  const cTable=new THREE.Group();
  const ctTop=new THREE.Mesh(new THREE.BoxGeometry(0.95,0.07,1.25), mat(0x232b38)); ctTop.position.y=0.34; cTable.add(ctTop);
  [[-0.4,-0.55],[0.4,-0.55],[-0.4,0.55],[0.4,0.55]].forEach(p=>{ const lg=new THREE.Mesh(new THREE.BoxGeometry(0.06,0.34,0.06), mat(0x11161e)); lg.position.set(p[0],0.17,p[1]); cTable.add(lg); });
  cTable.position.set(6.3,0,2.6); scene3.add(cTable);

  const shelf=new THREE.Group(); const shM=mat(0x232b38);
  const shBack=new THREE.Mesh(new THREE.BoxGeometry(0.06,2.6,2.2), shM); shBack.position.set(0,1.3,0); shelf.add(shBack);
  [0.15,0.95,1.75,2.5].forEach(y=>{ const sh=new THREE.Mesh(new THREE.BoxGeometry(0.42,0.06,2.2), shM); sh.position.set(0.2,y,0); shelf.add(sh); });
  const bookCols=[0xc9563c,0x3c78c9,0x53a06a,0xd9b380,0x8a63c9,0xc9d2dd];
  let bseed=7; const brnd=()=>{ bseed=(bseed*16807)%2147483647; return bseed/2147483647; };
  [0.15,0.95,1.75].forEach(y=>{ let z=-0.95; while(z<0.85){ const bw=0.09+brnd()*0.07, bh=0.34+brnd()*0.16; const bk=new THREE.Mesh(new THREE.BoxGeometry(0.26,bh,bw), mat(bookCols[Math.floor(brnd()*bookCols.length)])); bk.position.set(0.2,y+0.03+bh/2,z+bw/2); shelf.add(bk); z+=bw+0.015; } });
  shelf.position.set(-8.2,0,-0.6); scene3.add(shelf);

  // robot-robot
  if(S){ S.roster.forEach((def,i)=>{ const r=buildRobot(def); r.target.set(BACK_X[i],0,-4.15); r.group.position.copy(r.target); scene3.add(r.group); robots[def.id]=r; }); }
  sceneReady=true;
  bindOrbit(); resizeScene();
  requestAnimationFrame(animateScene);
  updateSceneLayout();
}
function drawChartCanvas(){
  if(!chartCtx) return;
  const g=chartCtx; g.fillStyle='#0d1117'; g.fillRect(0,0,512,320);
  g.strokeStyle='#232830'; g.beginPath(); for(let y=40;y<320;y+=56){ g.moveTo(0,y); g.lineTo(512,y); } g.stroke();
  g.fillStyle='#8b94a3'; g.font='18px monospace'; g.fillText('CPU LOAD % (nyata)', 14, 26);
  if(loadHistory.length<2){ g.fillStyle='#5d6675'; g.fillText('menunggu data…', 14, 60); chartTex.needsUpdate=true; return; }
  g.strokeStyle='#4cc38a'; g.lineWidth=3; g.beginPath();
  loadHistory.forEach((v,i)=>{ const x=10+i*(492/Math.max(47,loadHistory.length-1)); const y=300-Math.min(100,v)*2.6; i?g.lineTo(x,y):g.moveTo(x,y); });
  g.stroke(); g.lineWidth=1;
  g.fillStyle='#e6e9ee'; g.font='bold 22px monospace'; g.fillText((loadHistory[loadHistory.length-1]||0)+'%', 430, 30);
  chartTex.needsUpdate=true;
}
function drawCodeCanvas(){
  if(!codeCtx || !S) return;
  const g=codeCtx; g.fillStyle='#0d1117'; g.fillRect(0,0,512,320);
  g.font='15px monospace';
  const lines=S.log.slice(0,40).map(l=>(l.source+' • '+l.text));
  if(!lines.length) lines.push('// menunggu aktivitas agent…');
  const off=(Date.now()/40)%18;
  lines.forEach((ln,i)=>{ const y=28+i*18-off; if(y<8||y>316) return; g.fillStyle=i%3?'#7ee787':'#79c0ff'; g.fillText(ln.slice(0,58), 10, y); });
  codeTex.needsUpdate=true;
}
// Zona jalan-jalan agent (menghindari meja kerja, sofa, dan tanaman)
const WANDER_ZONES=[
  {x:[-5.4,5.4], z:[1.3,3.7]},     // area depan ruangan
  {x:[-7.3,-5.9], z:[-3.8,1.0]},   // lorong kiri (sepanjang rak buku)
  {x:[5.9,7.1], z:[-3.3,-1.3]},    // kanan belakang, dekat tanaman
  {x:[-5.4,5.4], z:[-4.8,-3.9]}    // strip dinding belakang
];
function pickWanderTarget(r){
  const p=r.group.position;
  for(let tries=0; tries<8; tries++){
    const zn=WANDER_ZONES[Math.floor(Math.random()*WANDER_ZONES.length)];
    const x=zn.x[0]+Math.random()*(zn.x[1]-zn.x[0]);
    const z=zn.z[0]+Math.random()*(zn.z[1]-zn.z[0]);
    if(Math.hypot(x-p.x, z-p.z)>2.2) return {x, z};
  }
  return {x:0, z:2.6};
}
function lerpAngle(a, b, t){
  let d=(b-a)%(Math.PI*2);
  if(d>Math.PI) d-=Math.PI*2;
  if(d<-Math.PI) d+=Math.PI*2;
  return a+d*t;
}
function updateSceneLayout(){
  if(!sceneReady || !S) return;
  // robot dibuat setelah data pertama tiba
  if(S.roster && Object.keys(robots).length===0){
    S.roster.forEach((def,i)=>{ const r=buildRobot(def); r.target.set(BACK_X[i],0,-4.15); r.group.position.copy(r.target); scene3.add(r.group); robots[def.id]=r; });
  }
  const working=S.agents.filter(a=>a.status==='working');
  const seatOf={}; working.forEach((a,i)=>{ seatOf[a.id]=i; });
  S.agents.forEach((a,idx)=>{
    const r=robots[a.id]; if(!r) return;
    const statusChanged=r.status!==a.status;
    r.status=a.status;
    if(a.status==='working'){
      const si=seatOf[a.id];
      r.targetSeated=true;
      r.target.set(STATION_X[si],-0.28,-1.38);
      const sm=stationScreens[si]; if(sm) sm.color.set(0x1d3a2a);
    }else{
      r.targetSeated=false;
      // agent idle / pause tidak lagi diam di dinding: jalan-jalan keliling kantor.
      // Target jalannya diatur di animateScene (pickWanderTarget).
      if(statusChanged){ r.walkTarget=null; r.waitUntil=performance.now()+600+Math.random()*1800; }
      r.target.copy(r.group.position);
    }
    if(statusChanged){
      const col=a.status==='working'?'#4cc38a':(a.status==='paused'?'#e8b93e':'#8b94a3');
      drawLabel(r.label, a.name+(a.status==='paused'?' (pause)':''), col);
    }
  });
  // lampu status ruangan
  if(lampMat){
    if(S.dispatch_paused) lampMat.color.set(0xe8b93e);
    else if(working.length) lampMat.color.set(0x4cc38a);
    else lampMat.color.set(0x