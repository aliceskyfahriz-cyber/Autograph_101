8b94a3);
  }
  // layar stasiun kosong redup
  STATION_X.forEach((x,i)=>{ const sm=stationScreens[i]; if(sm && !working.some((a,j)=>seatOf[a.id]===i)) sm.color.set(0x11161d); });
}
function animateScene(){
  requestAnimationFrame(animateScene);
  if(!renderer3) return;
  const now=performance.now(), t=now/1000;
  for(const id in robots){
    const r=robots[id];
    const p=r.group.position;
    const dt=Math.min(0.05, r.lastTick? (now-r.lastTick)/1000 : 0.016); r.lastTick=now;
    let baseY=0;
    if(r.status==='working'){
      r.moving=false; r.walkTarget=null;
      p.x+=(r.target.x-p.x)*0.045; p.z+=(r.target.z-p.z)*0.045;
      baseY=r.target.y;
      r.faceY=lerpAngle(r.faceY, 0, 0.1);
      if(Math.abs(p.x-r.target.x)<0.3 && Math.abs(p.z-r.target.z)<0.3){ r.seated=r.targetSeated; r.legs.visible=!r.seated; }
    }else{
      // jalan-jalan keliling kantor (idle & pause tetap bergerak)
      r.seated=false; r.legs.visible=true;
      if(!r.walkTarget && now>=r.waitUntil) r.walkTarget=pickWanderTarget(r);
      if(r.walkTarget){
        const dx=r.walkTarget.x-p.x, dz=r.walkTarget.z-p.z, dist=Math.hypot(dx,dz);
        if(dist<0.14){ r.walkTarget=null; r.waitUntil=now+1600+Math.random()*3600; r.moving=false; }
        else{
          const speed=(r.status==='paused'?0.7:1.15);
          const step=Math.min(dist, speed*dt);
          p.x+=dx/dist*step; p.z+=dz/dist*step;
          r.moving=true; r.walkPhase+=dt*7.5;
          r.faceY=lerpAngle(r.faceY, Math.atan2(dx,dz), 0.14);
        }
      }else r.moving=false;
      baseY=r.moving? Math.abs(Math.sin(r.walkPhase))*0.055 : Math.sin(t*1.4+r.phase)*0.02;
    }
    r.group.rotation.y=r.faceY;
    // cheer hop
    let hop=0;
    if(r.hopStart>0){ const pr=(now-r.hopStart)/900; if(pr>=1){ r.hopStart=-1; } else hop=Math.sin(pr*Math.PI)*0.55; }
    p.y+= ((baseY+hop)-p.y)*0.12;
    // kedip mata
    if(t>r.blinkAt){ r.blinkPhase=0.14; r.blinkAt=t+1.8+Math.random()*3.2; }
    if(r.blinkPhase>0){ r.blinkPhase-=0.016; const s=r.blinkPhase>0?0.12:1; r.eyeL.scale.y=s; r.eyeR.scale.y=s; if(r.extra.lens) r.extra.lens.scale.y=s; }
    // animasi kerja per peran
    if(r.status==='working'){
      if(id==='aris'){ r.armR.rotation.x=-1.1+Math.sin(t*3.1)*0.3; r.armR.rotation.z=Math.cos(t*3.1)*0.25; r.armL.rotation.x=-0.7; }
      else if(id==='udin'){ r.armR.rotation.x=-0.9+Math.sin(t*6)*0.12; r.armL.rotation.x=-0.9+Math.cos(t*6)*0.12; r.headG.rotation.y=Math.sin(t*0.9)*0.12; }
      else if(id==='vision-agent-03'){ r.headG.rotation.y=Math.sin(t*1.4)*0.3; r.armR.rotation.x=-0.4; r.armL.rotation.x=-0.4; }
      else if(id==='research-agent-01'){ r.armR.rotation.x=-1.5+Math.sin(t*1.8)*0.15; r.armL.rotation.x=-0.2; r.headG.rotation.y=Math.sin(t*1.1)*0.18; }
      else { r.armR.rotation.x=-1+Math.sin(t*9)*0.22; r.armL.rotation.x=-1+Math.cos(t*9)*0.22; r.headG.rotation.y=0; }
    }else if(r.status==='paused'){
      r.armR.rotation.x*=0.9; r.armL.rotation.x*=0.9; r.headG.rotation.x=0.12;
    }else{
      r.armR.rotation.x=Math.sin(t*1.4+r.phase)*0.07; r.armL.rotation.x=Math.cos(t*1.4+r.phase)*0.07; r.headG.rotation.x=0; r.headG.rotation.y=Math.sin(t*0.6+r.phase)*0.08;
    }
    // ayunan kaki & lengan saat berjalan
    if(r.moving){
      const sw=Math.sin(r.walkPhase);
      if(r.legL) r.legL.rotation.x=sw*0.55;
      if(r.legR) r.legR.rotation.x=-sw*0.55;
      r.armL.rotation.x=-sw*0.35; r.armR.rotation.x=sw*0.35;
    }else{
      if(r.legL) r.legL.rotation.x*=0.8;
      if(r.legR) r.legR.rotation.x*=0.8;
    }
    if(r.extra.recM){ const on=Math.sin(t*4)>0; r.extra.recM.color.set(on?0xff3b30:0x661512); }
  }
  if(Math.floor(now/130)!==Math.floor((now-16)/130)) drawCodeCanvas();
  // kamera orbit
  const sp=Math.sin(orbit.phi), x=orbit.tx+orbit.radius*sp*Math.sin(orbit.theta);
  const z=orbit.tz+orbit.radius*sp*Math.cos(orbit.theta);
  const y=orbit.ty+orbit.radius*Math.cos(orbit.phi);
  camera3.position.set(x,y,z); camera3.lookAt(orbit.tx,orbit.ty,orbit.tz);
  renderer3.render(scene3,camera3);
}
function resizeScene(){
  if(!renderer3) return;
  const c=$('#sceneContainer'); const w=c.clientWidth||window.innerWidth, h=c.clientHeight||window.innerHeight;
  renderer3.setSize(w,h); camera3.aspect=w/h; camera3.updateProjectionMatrix();
}
window.addEventListener('resize',resizeScene);
function bindOrbit(){
  const el=renderer3.domElement;
  const ray=new THREE.Raycaster(), ptr=new THREE.Vector2();
  let dragging=false, moved=0, lastX=0, lastY=0, downAt=0, pinchD=0;
  el.style.touchAction='none';
  el.addEventListener('pointerdown',e=>{ dragging=true; moved=0; lastX=e.clientX; lastY=e.clientY; downAt=Date.now(); el.setPointerCapture(e.pointerId); });
  el.addEventListener('pointermove',e=>{
    if(!dragging) return;
    const dx=e.clientX-lastX, dy=e.clientY-lastY; lastX=e.clientX; lastY=e.clientY;
    moved+=Math.abs(dx)+Math.abs(dy);
    orbit.theta-=dx*0.005;
    orbit.phi=Math.min(1.45,Math.max(0.35,orbit.phi-dy*0.005));
  });
  el.addEventListener('pointerup',e=>{
    dragging=false;
    if(moved<6 && Date.now()-downAt<400){
      const rect=el.getBoundingClientRect();
      ptr.x=((e.clientX-rect.left)/rect.width)*2-1;
      ptr.y=-((e.clientY-rect.top)/rect.height)*2+1;
      ray.setFromCamera(ptr,camera3);
      const hits=ray.intersectObjects(scene3.children,true);
      for(const h of hits){
        let o=h.object;
        while(o){ if(o.userData && o.userData.robotId){ toggleAgentPause(o.userData.robotId); return; } o=o.parent; }
      }
    }
  });
  el.addEventListener('wheel',e=>{ e.preventDefault(); orbit.radius=Math.min(19,Math.max(5.5,orbit.radius+e.deltaY*0.01)); },{passive:false});
  el.addEventListener('touchmove',e=>{
    if(e.touches.length===2){
      const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX, e.touches[0].clientY-e.touches[1].clientY);
      if(pinchD) orbit.radius=Math.min(19,Math.max(5.5,orbit.radius+(pinchD-d)*0.02));
      pinchD=d;
    }
  },{passive:true});
  el.addEventListener('touchend',()=>{ pinchD=0; });
}

/* ================= Mulai ================= */
document.body.classList.add('office-active');
initScene();
poll();
</script>
</body>
</html>
